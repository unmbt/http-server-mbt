{
  "git": {
    "requireCleanWorkingDir": false,
    "tagName": "v${version}",
    "commitMessage": "chore: release v${version}"
  },
  "hooks": {
    "before:init": ["echo Starting release process..."],
    "after:bump": [
      "node scripts/bump.js ${version}"
    ]
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  }
}
