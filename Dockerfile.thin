# syntax=docker/dockerfile:1
# ----------------------------------------------------------------------
# Thin Variant Dockerfile
# Based on Google Distroless static nonroot image (D-15 specification).
# Packages pre-compiled static binary with pure MoonBit HTTP engine
# (zero C crypto/proxy dependencies).
# ----------------------------------------------------------------------

ARG BASE_IMAGE=gcr.io/distroless/static:nonroot
FROM ${BASE_IMAGE}

ARG BINARY_PATH=http-server-mbt-thin

# Default directory to serve files from
WORKDIR /data

# Copy pre-compiled binary from host / CI build artifact
COPY ${BINARY_PATH} /usr/local/bin/http-server-mbt-thin

# UID 65532 is nonroot user in Distroless
USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/http-server-mbt-thin"]
CMD [".", "-p", "8080"]
