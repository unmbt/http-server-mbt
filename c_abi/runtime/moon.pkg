import {
  "unmbt/http-server-mbt" @engine,
  "unmbt/http-server-mbt/core",
  "unmbt/http-server-mbt/internal/request_headers",
  "moonbitlang/async",
  "moonbitlang/async/pipe",
  "moonbitlang/async/types",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

options(
  "native-stub": [ "bridge.c" ],
  link: {
    "native": {
      "cc-flags": "${build.HS_C_FLAGS}",
      "stub-cc-flags": "${build.HS_C_FLAGS}",
    },
  },
)
