import {
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "unmbt/http-server-mbt/core",
  "unmbt/http-server-mbt/internal/static_plan" @plan,
  "unmbt/http-server-mbt/internal/native",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
} for "test"

options(
  targets: { "*.mbt": [ "native" ] },
  link: {
    "native": {
      "cc-flags": "${build.HS_C_FLAGS}",
      "stub-cc-flags": "${build.HS_C_FLAGS}",
    },
  },
)
