///|
// D-15 / T-030. Four actual containers consume the already audited musl CLIs.
// No shell inside images and no separate benchmark/demo server.
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn command(args : Array[String]) -> String {
  let result = @shell.Cmd("docker", args).output()
  result.check()
  result.stdout().trim().to_owned()
}

///|
async fn request(url : String, args? : Array[String] = []) -> String {
  let result = @shell.Cmd(
    "curl",
    [
      "--fail", "--silent", "--show-error", "--retry", "30", "--retry-connrefused",
      "--retry-delay", "1", "--max-time", "10", ..args, url,
    ],
  ).output()
  result.check()
  result.stdout()
}

///|
async fn main {
  let os = @shell.Cmd("uname", ["-s"]).output()
  os.check()
  assert_eq(os.stdout().trim(), "Linux")
  let out = "target/candidate/containers"
  if !@fs.exists(out) {
    @fs.mkdir(out, recursive=true)
  }
  let context = @fs.tmpdir(prefix="hs-container-")
  let fixtures = context + "/fixtures"
  @fs.mkdir(fixtures)
  @fs.write_file(fixtures + "/hello.txt", "hello moonbit\n")
  // Private local trust only: verify DNS through Docker's named service and TLS
  // against this explicit root. Certificate validity does not depend on a fixture date.
  @shell.Cmd("openssl", [
    "req",
    "-x509",
    "-newkey",
    "rsa:2048",
    "-nodes",
    "-days",
    "2",
    "-subj",
    "/CN=origin.test",
    "-addext",
    "subjectAltName=DNS:origin.test",
    "-keyout",
    fixtures + "/key.pem",
    "-out",
    fixtures + "/cert.pem",
  ]).run()
  @shell.Cmd("chmod", ["644", fixtures + "/key.pem"]).run()
  let network = "hs-candidate-" +
    @env.get_env_var("GITHUB_RUN_ID").unwrap_or("local")
  ignore(command(["network", "create", network]))
  defer ignore(command(["network", "rm", network]))
  let records : Array[Json] = []
  for flavor in ["thin", "full"] {
    let name = if flavor == "thin" {
      "http-server-mbt-thin"
    } else {
      "http-server-mbt"
    }
    let artifact = "target/candidate/cli/" + name + "-linux-amd64"
    let hash = @shell.Cmd("sha256sum", [artifact]).output()
    hash.check()
    let expected = hash.stdout().split(" ").next().unwrap().to_owned()
    @fs.write_file(context + "/" + name, @fs.read_file(artifact))
    @fs.write_file(
      context + "/Dockerfile",
      @fs.read_file(
        if flavor == "thin" {
          "Dockerfile.thin"
        } else {
          "Dockerfile"
        },
      ),
    )
    for base in ["distroless", "scratch"] {
      let tag = "http-server-mbt-candidate:" + flavor + "-" + base
      let args = ["build", "--build-arg", "BINARY_PATH=" + name, "-t", tag]
      if base == "scratch" {
        args.push("--build-arg")
        args.push("BASE_IMAGE=scratch")
      }
      args.push(context)
      @shell.Cmd("docker", args).run()
      let image = @json.parse(command(["image", "inspect", tag]))
      guard image
        is [
          {
            "Id": String(image_id),
            "Config": { "User": String("65532:65532"), .. },
            ..
          },
          ..,
        ] else {
        fail("container must declare UID/GID 65532")
      }
      let id = command([
        "run",
        "-d",
        "--read-only",
        "--network",
        network,
        "-p",
        "127.0.0.1::8080",
        "--mount",
        "type=bind,src=" + fixtures + ",dst=/data,readonly",
        tag,
        "/data",
        "-p",
        "8080",
      ])
      defer ignore(command(["rm", "-f", id]))
      let port = command(["port", id, "8080/tcp"])
        .split(":")
        .to_array()
        .last()
        .unwrap()
        .to_owned()
      let url = "http://127.0.0.1:" + port + "/hello.txt"
      assert_eq(request(url), "hello moonbit\n")
      assert_true(request(url, args=["--head"]).contains("200 OK"))
      assert_eq(request(url, args=["-H", "Range: bytes=6-12"]), "moonbit")
      let config = @json.parse(command(["inspect", id]))
      guard config
        is [
          {
            "HostConfig": { "ReadonlyRootfs": True, .. },
            "Mounts": [{ "RW": False, .. }, ..],
            ..
          },
          ..,
        ] else {
        fail("readonly root/mount contract missing")
      }
      ignore(
        command(["cp", id + ":/usr/local/bin/" + name, context + "/from-image"]),
      )
      let actual = @shell.Cmd("sha256sum", [context + "/from-image"]).output()
      actual.check()
      assert_eq(actual.stdout().split(" ").next().unwrap(), expected)
      ignore(command(["stop", "--time", "8", id]))
      let stopped = @json.parse(command(["inspect", id]))
      guard stopped
        is [
          {
            "State": { "ExitCode": Number(exit, ..), "OOMKilled": False, .. },
            ..
          },
          ..,
        ] &&
        (exit == 0 || exit == 143) else {
        fail("PID 1 failed graceful SIGTERM drain (SIGKILL/137 forbidden)")
      }
      if flavor == "full" {
        let origin = command([
          "run",
          "-d",
          "--read-only",
          "--network",
          network,
          "--network-alias",
          "origin.test",
          "--mount",
          "type=bind,src=" + fixtures + ",dst=/data,readonly",
          tag,
          "/data",
          "-p",
          "8080",
          "--cert",
          "/data/cert.pem",
          "--key",
          "/data/key.pem",
        ])
        defer ignore(command(["rm", "-f", origin]))
        let proxy = command([
          "run",
          "-d",
          "--read-only",
          "--network",
          network,
          "-p",
          "127.0.0.1::8080",
          "--mount",
          "type=bind,src=" + fixtures + ",dst=/data,readonly",
          tag,
          "/data",
          "-p",
          "8080",
          "--proxy",
          "https://origin.test:8080",
          "--proxy-all",
          "--ca-file",
          "/data/cert.pem",
        ])
        defer ignore(command(["rm", "-f", proxy]))
        let proxy_port = command(["port", proxy, "8080/tcp"])
          .split(":")
          .to_array()
          .last()
          .unwrap()
          .to_owned()
        assert_eq(
          request("http://127.0.0.1:" + proxy_port + "/hello.txt"),
          "hello moonbit\n",
        )
        ignore(command(["stop", "--time", "8", proxy, origin]))
      }
      records.push({
        "flavor": flavor,
        "base": base,
        "image": image_id,
        "cli_sha256": expected,
        "get_head_range": true,
        "uid_gid": "65532:65532",
        "readonly": true,
        "pid1_sigterm": true,
        "dns_explicit_ca_tls": flavor == "full",
      })
    }
  }
  @fs.write_file(out + "/matrix.json", records.to_json().stringify(indent=2))
}
