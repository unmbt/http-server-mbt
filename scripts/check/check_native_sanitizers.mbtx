///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let moon_root = @env.get_env_var("MOON_HOME").unwrap_or(
    @env.get_env_var("HOME").unwrap_or(
      @env.get_env_var("USERPROFILE").unwrap_or(""),
    ) +
    "/.moon",
  )
  let headers = if @fs.exists(moon_root + "/include/moonbit.h") {
    moon_root + "/include"
  } else if @fs.exists(moon_root + "/lib/moonbit.h") {
    moon_root + "/lib"
  } else {
    fail("MoonBit header not found under " + moon_root)
  }
  if !@fs.exists("target/sanitizer") {
    @fs.mkdir("target/sanitizer", recursive=true)
  }
  let binary = "target/sanitizer/native-owner" +
    (if windows { ".exe" } else { "" })
  let sanitizers = if windows { "address" } else { "address,undefined" }
  let mac = !windows &&
    @shell.Cmd("uname", ["-s"]).output().stdout().trim() == "Darwin"
  let args = [
    "-std=c11",
    "-O1",
    "-g",
    "-fno-omit-frame-pointer",
    "-fsanitize=" + sanitizers,
    "-I",
    headers,
    "tests/native_sanitizer/main.c",
    "-o",
    binary,
  ]
  if !windows {
    args.push("-pthread")
  }
  // Apple's clang knows the active Xcode SDK; the separately installed LLVM
  // clang has no default macOS sysroot on the Actions runner.
  let compiler = if mac { "/usr/bin/clang" } else { "clang" }
  @shell.Cmd(compiler, args).run()
  if windows {
    let resource = @shell.Cmd("clang", ["--print-resource-dir"])
      .output()
      .stdout()
      .trim()
      .to_owned()
    @fs.write_file(
      "target/sanitizer/clang_rt.asan_dynamic-x86_64.dll",
      @fs.read_file(resource + "/lib/windows/clang_rt.asan_dynamic-x86_64.dll").binary(),
    )
  }
  let rounds = if @env.get_env_var("HS_EXTENDED_EXPLORATION") == Some("1") {
    "4096"
  } else {
    "128"
  }
  for
    seed in @fs.read_file("testdata/native_sanitizer/seeds.txt")
    .text()
    .split("\n") {
    let seed = seed.trim().to_owned()
    if seed == "" {
      continue
    }
    // LeakSanitizer is supported on this Linux runner, but not on macOS or Windows.
    let result = @shell.Cmd(
      binary,
      ["testdata/public", seed, rounds],
      env=Map([
        (
          "ASAN_OPTIONS",
          "detect_leaks=" + (if windows || mac { "0" } else { "1" }),
        ),
      ]),
    ).output(timeout_ms=300000)
    @fs.write_file(
      "target/sanitizer/" + seed + ".log",
      result.stdout() + result.stderr(),
    )
    result.check()
    println(
      result
      .stdout()
      .split("\n")
      .filter(s => s.contains("drained"))
      .to_array()
      .join("\n"),
    )
  }
}
