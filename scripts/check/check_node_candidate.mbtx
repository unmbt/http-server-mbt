///|
// Candidate tarballs are installed into a new directory with registry access
// disabled. Run under both Node 22 and 24; never publish from this driver.
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  @shell.Cmd("moon", ["run", "scripts/maintenance/stage_licenses.mbtx"]).run()
  let version = @shell.Cmd("node", ["--version"])
    .output()
    .stdout()
    .trim()
    .to_owned()
  if !version.has_prefix("v22.") && !version.has_prefix("v24.") {
    fail("candidate validation requires Node 22 or 24, got " + version)
  }
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let os = if windows {
    "win32-x64-msvc"
  } else if @shell.Cmd("uname", ["-s"]).output().stdout().trim() == "Darwin" {
    "darwin-arm64"
  } else {
    "linux-x64-gnu"
  }
  let root = @env.current_dir().unwrap().replace_all(old="\\", new="/")
  let workspace = @fs.tmpdir(prefix="hs-node-candidate-")
  let npm = if windows { "node" } else { "npm" }
  let npm_prefix : Array[String] = if windows {
    let executable = @shell.Cmd("where.exe", ["node"])
      .output()
      .stdout()
      .split("\n")
      .next()
      .unwrap()
      .trim()
      .to_owned()
      .replace_all(old="\\", new="/")
    let parts = executable.split("/").to_array()
    [parts[:parts.length() - 1].join("/") + "/node_modules/npm/bin/npm-cli.js"]
  } else {
    []
  }
  let archives : Array[String] = []
  for pkg in ["npm/" + os, "npm/http-server"] {
    let output = @shell.Cmd(
      npm,
      [..npm_prefix, "pack", "--json", "--pack-destination", workspace],
      cwd=root + "/" + pkg,
    ).output()
    output.check()
    guard @json.parse(output.stdout()) is [{ "filename": String(name), .. }, ..] else {
      fail("npm pack did not report a tarball")
    }
    archives.push(workspace + "/" + name)
  }
  @fs.write_file(
    workspace + "/package.json",
    "{\"name\":\"candidate-consumer\",\"version\":\"0.0.0\",\"private\":true}",
  )
  @shell.Cmd(
    npm,
    [
      ..npm_prefix, "install", "--offline", "--ignore-scripts", "--no-audit", "--no-fund",
      ..archives,
    ],
    cwd=workspace,
  ).run(timeout_ms=60000)
  let sample = @fs.read_file("tests/consumers/node/index.test.cjs")
    .text()
    .replace_all(
      old="require('../../../npm/http-server')",
      new="require('@unmbt/http-server-mbt')",
    )
    .replace_all(
      old="import('../../../npm/http-server/index.mjs')",
      new="import('@unmbt/http-server-mbt')",
    )
  @fs.write_file(workspace + "/consumer.cjs", sample)
  @fs.write_file(workspace + "/README.md", @fs.read_file("README.md"))
  @fs.write_file(workspace + "/LICENSE", @fs.read_file("LICENSE"))
  @shell.Cmd("node", ["consumer.cjs"], cwd=workspace).run(timeout_ms=60000)
  if !@fs.exists("target/candidate/node") {
    @fs.mkdir("target/candidate/node", recursive=true)
  }
  for archive in archives {
    let name = archive
      .replace_all(old="\\", new="/")
      .split("/")
      .to_array()
      .last()
      .unwrap()
      .to_owned()
    @fs.write_file("target/candidate/node/" + name, @fs.read_file(archive))
  }
  @fs.write_file(
    "target/candidate/node/" + version + ".txt",
    "PASS " +
    version +
    " " +
    os +
    "; offline candidate install; complete-server mode only\n",
  )
}
