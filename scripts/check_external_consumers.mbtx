import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs", "moonbitlang/async@0.21.3/shell", "moonbitlang/core/env" }
async fn main {
  let windows=@env.get_env_var("OS")==Some("Windows_NT")
  let mac=if windows { false } else { @shell.Cmd("uname",["-s"]).output().stdout().trim()=="Darwin" }
  let root=@env.current_dir().unwrap().replace_all(old="\\",new="/")
  let python=@env.get_env_var("PYTHON").unwrap_or(if windows { "python" } else { "python3" })
  for variant in ["thin","full"] {
    let binary="target/cabi/rust-"+variant+(if windows { ".exe" } else { "" })
    let args=["--edition=2021","testdata/rust_consumer/main.rs","-o",binary,"-L","native=target/cabi","-l","static="+(if windows { "hs_\{variant}_static" } else { "hs_\{variant}" })]
    if windows {
      args.append(["-C","target-feature=+crt-static"])
      for lib in ["crypt32","secur32","iphlpapi","ws2_32","mswsock","userenv","advapi32","synchronization","dbghelp","bcrypt","shell32"] { args.append(["-l",lib]) }
    } else {
      args.append(["-l","pthread","-l","m"])
      if !mac { args.append(["-l","dl"]) }
    }
    @shell.Cmd("rustc",args).run()
    @shell.Cmd(root+"/"+binary,[],cwd=root+"/target/cabi").run(timeout_ms=30000)
    let library=if windows { "hs_\{variant}.dll" } else { "libhs_\{variant}."+(if mac { "dylib" } else { "so" }) }
    @shell.Cmd(python,[root+"/testdata/python_consumer/main.py",root+"/target/cabi/"+library],cwd=root+"/target/cabi").run(timeout_ms=30000)
  }
}
