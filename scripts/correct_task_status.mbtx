import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  let path="docs/tasks.md"
  let source=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
  let active=["T-002","T-004","T-011","T-013","T-014","T-016","T-017","T-018","T-021","T-022","T-028","T-030","T-033","T-035"]
  let out=StringBuilder()
  for line in source.split("\n") {
    let mut text=line.to_owned()
    for id in active {
      if text.has_prefix("- [") && text.contains("**"+id+" ") {
        text=text.replace(old="- [x]",new="- [ ]")
        let status=text.find("状态：").unwrap()
        let stop=text[status:].find("。需求：").unwrap()+status
        text=text[:status].to_owned()+"状态：进行中（2026-09-24 按源码校正；本机分项与三平台总验收分开）"+text[stop:].to_owned()
      }
    }
    text=text.replace_all(old=".github/workflows/tls-and-lib-export.yml",new=".github/workflows/cabi.yml")
    if text.contains("经过 Reviewer（2位）") || text.contains("经 Reviewer（2位）") || text.contains("Windows 本机全功能测试与质量门槛完全达标") {
      out.write_string("  - 历史记录限定：以下是此前工具链/工作树的陈述，未附可复用的完整提交、Actions job 和产物哈希；不作为 2026-09-24 本轮验收，也不代表状态机模型或三平台总交付。\n")
    }
    if text.contains("所有条目在 Windows Native 下已全部完成迁移") {
      text="下表保留 42 个原版文件及 C/CC/CE 稳定编号。历史 Windows 套件的通过记录不等于逐断言、逐形态、逐平台迁移全部完成；最终覆盖须由 T-026 对照源码和本轮证据审计，未验证项不得从分母移除。"
    }
    out.write_string(text+"\n")
  }
  @fs.write_file(path,out.to_string())
}
