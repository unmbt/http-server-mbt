///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
}

///|
async fn main {
  for file in @fs.readdir("server") {
    if !file.has_suffix("_test.mbt") {
      continue
    }
    println("START " + file)
    let result = @shell.Cmd("moon", [
      "test",
      "--target",
      "native",
      "server/" + file,
      "--verbose",
    ]).output(timeout_ms=45000) catch {
      e => {
        println("TIMEOUT " + file + " " + e.to_string())
        continue
      }
    }
    println(result.stdout())
    println(result.stderr())
    println("EXIT \{result.exit_code()} " + file)
  }
}
