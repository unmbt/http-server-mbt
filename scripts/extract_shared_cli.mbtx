import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }

async fn read(path : String) -> String {
  @fs.read_file(path).text().replace_all(old="\r\n",new="\n")
}

async fn main {
  let full="cmd/http-server-mbt"
  let thin="cmd/http-server-mbt-thin"
  for file in ["banner.mbt","color.mbt","local_ips.mbt","local_ips.c","tty.c","generated_version.mbt"] {
    @fs.write_file("cmd/common/"+file,@fs.read_file(full+"/"+file))
    @fs.remove(full+"/"+file)
    @fs.remove(thin+"/"+file)
  }
  for file in ["cli_wbtest.mbt","cli_challenger_wbtest.mbt","local_ips_wbtest.mbt"] {
    @fs.write_file("cmd/common/"+file,@fs.read_file(full+"/"+file))
    @fs.remove(full+"/"+file)
  }
  let thin_tests=read(thin+"/cli_wbtest.mbt").replace_all(old="parse_cli(",new="parse_thin_cli(")
  @fs.write_file("cmd/common/thin_cli_wbtest.mbt",thin_tests+"\n///|\nfn parse_thin_cli(args : ArrayView[String]) -> Result[CliAction,String] { parse_cli(args,thin=true) }\n")
  @fs.remove(thin+"/cli_wbtest.mbt")
  let source=read(full+"/cli.mbt")
  let start=source.find("///|\nfn first_value").unwrap()
  let end=source.find("///|\n/// Parse CLI arguments").unwrap()
  let source=(source[:start].to_owned()+source[end:].to_owned())
    .replace_all(old="build_command()",new="build_command(thin~ : Bool = false)")
    .replace_all(old="let cmd = build_command(thin~ : Bool = false)",new="let cmd = build_command(thin~)")
    .replace_all(old="parse_cli(args : ArrayView[String])",new="parse_cli(args : ArrayView[String], thin~ : Bool = false)")
    .replace_all(old="    \"http-server-mbt\",",new="    if thin { \"http-server-mbt-thin\" } else { \"http-server-mbt\" },")
    .replace_all(old="about=\"Windows Native static HTTP server\"",new="about=if thin { \"Native static HTTP server (TLS/proxy require Full)\" } else { \"Native static HTTP server\" }")
  let rejection=
    #|  if thin {
    #|    if first_value(matches, "cert") is Some(_) || first_value(matches, "key") is Some(_) || first_value(matches, "key-passphrase") is Some(_) {
    #|      return Err("TLS is not supported in thin build; use http-server-mbt (full build)")
    #|    }
    #|    if first_value(matches, "proxy") is Some(_) || matches.flags.get("proxy-all") == Some(true) || first_value(matches, "proxy-config") is Some(_) {
    #|      return Err("Proxy is not supported in thin build; use http-server-mbt (full build)")
    #|    }
    #|  }
    #|
  @fs.write_file("cmd/common/cli.mbt",source.replace_all(old="  // 1. Port",new=rejection+"  // 1. Port"))
  let run=read(full+"/main.mbt")
  let run=run[:run.find("///|\nfn main").unwrap()].to_owned()
    .replace_all(old="async fn run() -> Unit",new="pub async fn run(thin~ : Bool, launch : async (@core.Config, Int, async () -> Unit) -> Unit) -> Unit")
    .replace_all(old="parse_cli(args)",new="parse_cli(args,thin~)")
    .replace_all(old="@full.with_server_at(final_config, port, async fn(_server)",new="launch(final_config, port, async fn()")
  @fs.write_file("cmd/common/run.mbt",run)
  for (path,service) in [(full,"full"),(thin,"server/plain")] {
    @fs.remove(path+"/cli.mbt")
    let is_thin=path==thin
    @fs.write_file(path+"/main.mbt","///|\nfn main {\n  @async.run_async_main(async fn() {\n    @common.run(thin=\{is_thin}, async fn(config, port, ready) {\n      @server.with_server_at(config,port,async fn(_server) { ready() })\n    })\n  })\n}\n")
    @fs.write_file(path+"/moon.pkg","import {\n  \"unmbt/http-server-mbt/cmd/common\",\n  \"unmbt/http-server-mbt/\{service}\" @server,\n  \"moonbitlang/async\",\n}\npkgtype(kind: \"executable\")\n")
  }
  @fs.write_file("cmd/common/moon.pkg",
    #|import {
    #|  "unmbt/http-server-mbt/core",
    #|  "moonbitlang/async@0.21.3",
    #|  "moonbitlang/async@0.21.3/stdio",
    #|  "moonbitlang/async@0.21.3/fs",
    #|  "moonbitlang/core/env",
    #|  "moonbitlang/core/argparse",
    #|  "moonbitlang/core/encoding/utf8",
    #|}
    #|rule(name: "gen_version", command: "moon run scripts/gen_version.mbtx $input $output")
    #|dev_build(rule: "gen_version", input: "../../moon.mod", output: "generated_version.mbt")
    #|options("native-stub": ["local_ips.c", "tty.c"], targets: { "*.mbt": ["native"] })
    #|
  )
}
