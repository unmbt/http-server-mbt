import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  for (path,field) in [("server/server.mbt","inner"),("server/plain/plain.mbt","listener")] {
    let s=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
    let s=s.replace(old="  mut task : @async.Task[Unit]?",new="  mut task : @async.Task[Unit]?\n  mut accept_task : @async.Task[Unit]?")
      .replace(old="    task: None,",new="    task: None,\n    accept_task: None,")
      .replace(old="        while !server.stopped {",new="        let accepting=clients.spawn(allow_failure=true,() => {\n          defer listener.close()\n        while !server.stopped {")
      .replace(old="        }\n      }\n    })",new="        }\n        })\n        server.accept_task=Some(accepting)\n      }\n    })")
      .replace(old="if !self.stopped { self.stopped = true; self."+field+".close() }",new="if !self.stopped {\n    self.stopped = true\n    if self.accept_task is Some(task) { task.cancel() }\n  }")
    @fs.write_file(path,s)
  }
}
