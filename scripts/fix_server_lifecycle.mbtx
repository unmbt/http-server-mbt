import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  for (path,field,handler) in [("server/server.mbt","inner","handle_connection(server, tcp)"),("server/plain/plain.mbt","listener","handle_connection(server, tcp)")] {
    let s=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
    let start=s.find("      listener.run_forever(").unwrap()
    let end=start+s[start:].find("    })").unwrap()
    let replacement=
      #|      @async.with_task_group() <| clients => {
      #|        let capacity=@async.Semaphore(config.limits.connections)
      #|        while !server.stopped {
      #|          capacity.acquire()
      #|          if server.stopped { capacity.release(); break }
      #|          let (tcp,_) = listener.accept() catch {
      #|            e => { capacity.release(); if server.stopped { break } else { raise e } }
      #|          }
      #|          clients.spawn_bg(allow_failure=true,() => {
      #|            defer capacity.release()
      #|            defer tcp.close()
      #|            HANDLE
      #|          })
      #|        }
      #|      }
      #|
    let s=s[:start].to_owned()+replacement.replace(old="HANDLE",new=handler)+s[end:].to_owned()
    let s=s.replace(old="  self.stopped = true\n}",new="  if !self.stopped { self.stopped = true; self."+field+".close() }\n}")
    let s=s.replace(old="  if self.task is Some(t) {\n    t.cancel()\n  }",new="  @async.protect_from_cancel(() => {\n    if self.task is Some(t) { t.cancel(); ignore(t.wait() catch { _ => () }) }\n    self.engine.close()\n  })")
    @fs.write_file(path,s)
  }
}
