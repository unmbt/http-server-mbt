import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

///|
suberror GenVersionError {
  MissingVersion
  MalformedVersionLine(String)
}

///|
impl Show for GenVersionError with fn output(self, logger) {
  match self {
    MissingVersion => logger.write_string("missing `version = \"...\"` entry")
    MalformedVersionLine(line) =>
      logger.write_string("malformed version line: \{line}")
  }
}

///|
/// Build-time generator for cmd/http-server-mbt/generated_version.mbt.
/// Reads the module manifest ($input), extracts `version = "..."`, and
/// rewrites $output only when the content would change, so repeated dev
/// commands stay no-op. Wired by the dev_build rule in
/// cmd/http-server-mbt/moon.pkg; both paths are relative to the module root,
/// which is also the working directory of the rule command.
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    abort("usage: moon run scripts/gen_version.mbtx <moon.mod> <output.mbt>")
  }
  let input = args[1]
  let output = args[2]
  let manifest = @fs.read_file(input).text() catch {
    err => abort("gen_version: cannot read \{input}: \{err}")
  }
  let version = parse_version(manifest) catch {
    err => abort("gen_version: \{input}: \{err}")
  }
  let generated = generate(version)
  let existing = if @fs.exists(output) {
    @fs.read_file(output).text() catch { _ => "" }
  } else {
    ""
  }
  if existing != generated {
    @fs.write_file(output, generated)
    println("gen_version: wrote \{output} (version \{version})")
  }
}

///|
fn is_key_separator(c : UInt16) -> Bool {
  c == '=' || c == ' ' || c == '\t'
}

///|
/// Extract the module version from moon.mod content: the single
/// `version = "x.y.z"` line. Fails loudly on a missing or malformed entry so
/// manifest format changes surface at build time instead of shipping a stale
/// or empty version string.
fn parse_version(manifest : String) -> String raise GenVersionError {
  for line in manifest.split("\n") {
    let trimmed = line.trim().to_owned()
    if !trimmed.has_prefix("version") {
      continue
    }
    let after_key = trimmed["version".length():].to_owned()
    if after_key.length() == 0 || !is_key_separator(after_key[0]) {
      continue
    }
    match after_key.find("=") {
      None => continue
      Some(eq) => {
        let raw = after_key[eq + 1:].to_owned().trim().to_owned()
        if !(
          raw.length() >= 2 && raw.has_prefix("\"") && raw.has_suffix("\"")
        ) {
          raise MalformedVersionLine(trimmed)
        }
        let value = raw[1:raw.length() - 1].to_owned()
        if value.length() == 0 {
          raise MalformedVersionLine(trimmed)
        }
        return value
      }
    }
  }
  raise MissingVersion
}

///|
/// Render the generated source. Kept byte-stable so unchanged inputs never
/// dirty the working tree.
fn generate(version : String) -> String {
  (
    $|// Generated by scripts/gen_version.mbtx from moon.mod. DO NOT EDIT.
    $|///|
    $|/// Version injected from the module manifest at build time; regenerated
    $|/// by the dev_build rule after moon.mod changes.
    $|let server_version : String = "\{version}"
    $|
  )
}
