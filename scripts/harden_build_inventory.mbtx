import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  let path="scripts/build_cabi.mbtx"
  let source=@fs.read_file(path).text()
  let source=source.replace_all(old="  println(\"2. Building MoonBit packages...\")",new=
    #|  // Start with an empty, repository-contained object inventory. Removed
    #|  // source files must never survive as stale library members.
    #|  for dir in ["target/cabi-build","target/cabi"] {
    #|    if file_exists(dir) {
    #|      let root=normalize_path(@fs.realpath("."))
    #|      let resolved=normalize_path(@fs.realpath(dir))
    #|      assert_eq(resolved,root+"/"+dir)
    #|      @fs.rmdir(resolved,recursive=true)
    #|    }
    #|  }
    #|  println("2. Building MoonBit packages...")
  )
  let mut source=source
  for variant in ["thin","full"] {
    let old="  try {\n    ignore(@shell.Cmd(\"moon\", [\"build\", \"c_abi/"+variant+"\", \"--target\", \"native\", \"--release\", \"--target-dir\", \"target/cabi-build\"]).output())\n  } catch {\n    _ => ()\n  }"
    assert_true(source.contains(old))
    source=source.replace_all(old~,new="  @shell.Cmd(\"moon\", [\"build\", \"c_abi/"+variant+"\", \"--target\", \"native\", \"--release\", \"--deny-warn\", \"--target-dir\", \"target/cabi-build\"]).run()")
  }
  @fs.write_file(path,source)
  let path="scripts/build_node.mbtx"
  let source=@fs.read_file(path).text()
  let start=source.find("  // 1. Direct path in c_abi/node/lib/node.lib").unwrap()
  let end=source.find("\n///|\nasync fn main").unwrap()
  let replacement=
    #|  // Node-API 8 import library, fixed independently of the host test version.
    #|  // Its exact hash is checked even when using an existing local cache.
    #|  let cached=@env.get_env_var("LOCALAPPDATA").unwrap_or("")+"/node-gyp/Cache/20.16.0/x64/node.lib"
    #|  let path=if file_exists(cached) { cached } else {
    #|    let dir="target/node/toolchain"
    #|    if !file_exists(dir) { @fs.mkdir(dir,recursive=true) }
    #|    let file=dir+"/node-v20.16.0.lib"
    #|    if !file_exists(file) {
    #|      @shell.Cmd("curl.exe",["--fail","--location","--silent","--show-error","https://nodejs.org/dist/v20.16.0/win-x64/node.lib","-o",file]).run()
    #|    }
    #|    file
    #|  }
    #|  let hash=@shell.Cmd("certutil",["-hashfile",path,"SHA256"]).output();hash.check()
    #|  if !hash.stdout().to_lower().contains("87056190b7cd06f40058f8e059efd328cdcc7600b825afa102c0aa5039865af5") {
    #|    fail_pipeline("Node import library hash mismatch")
    #|  }
    #|  path
    #|}
    #|
  @fs.write_file(path,source[:start].to_owned()+replacement+source[end:].to_owned())
  for pkg in ["http-server","win32-x64-msvc","darwin-arm64","linux-x64-gnu"] {
    let path="npm/"+pkg+"/package.json"
    let source=@fs.read_file(path).text().replace_all(old="\"license\": \"Apache-2.0\"",new="\"license\": \"MIT\"")
      .replace_all(old="\"README.md\"",new="\"README.md\",\n    \"LICENSE\",\n    \"licenses\"")
    @fs.write_file(path,source)
  }
}
