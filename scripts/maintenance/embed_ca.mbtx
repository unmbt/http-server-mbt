///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
}

///|
async fn main {
  let pem = @fs.read_file("full/cacert.pem").text()
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/maintenance/embed_ca.mbtx from the pinned cacert.pem.\n// Mozilla certificate data: MPL-2.0; see CA-PROVENANCE.md.\n\n///|\nlet mozilla_roots : String =\n",
  )
  for line in pem.split("\n") {
    out.write_string("  #|" + line.to_owned() + "\n")
  }
  @fs.write_file("full/ca_bundle.mbt", out.to_string())
}
