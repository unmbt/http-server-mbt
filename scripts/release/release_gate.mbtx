///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let sha = @env.get_env_var("RELEASE_COMMIT").unwrap()
  let run = @env.get_env_var("CANDIDATE_RUN").unwrap()
  let tag = @env.get_env_var("RELEASE_TAG").unwrap()
  let repo = @env.get_env_var("GITHUB_REPOSITORY").unwrap()
  if !run.iter().all(c => c >= '0' && c <= '9') ||
    sha.length() != 40 ||
    !tag.has_prefix("v") {
    fail("invalid release identifiers")
  }
  let commit = @shell.Cmd("git", ["rev-parse", tag + "^{commit}"]).output()
  commit.check()
  assert_eq(commit.stdout().trim(), sha)
  let response = @shell.Cmd("curl", [
    "--fail",
    "--silent",
    "--show-error",
    "-H",
    "Authorization: Bearer " + @env.get_env_var("GH_TOKEN").unwrap(),
    "https://api.github.com/repos/\{repo}/actions/runs/\{run}",
  ]).output()
  response.check()
  guard @json.parse(response.stdout())
    is {
      "head_sha": String(actual),
      "conclusion": String("success"),
      "path": String(".github/workflows/cli.yml"),
      ..
    } &&
    actual == sha else {
    fail("candidate run must be the successful same-commit acceptance workflow")
  }
  @shell.Cmd("moon", ["run", "scripts/release/verify_candidates.mbtx"]).run()
  let tasks = @fs.read_file("docs/tasks.md").text()
  let completed : Set[String] = Set([])
  for line in tasks.split("\n") {
    if line.has_prefix("- [x] **T-") {
      completed.add(line[8:13].to_owned())
    }
  }
  for id in 1..<=35 {
    if id == 24 {
      continue
    } // Explicitly withdrawn performance task, never reused.
    let task = "T-" + (if id < 10 { "00" } else { "0" }) + id.to_string()
    if !completed.contains(task) {
      fail(
        "full release blocked by " +
        task +
        "; candidate-only acceptance cannot waive original dependencies",
      )
    }
  }
  for dir in @fs.readdir("target/verified-candidates") {
    let manifest = @json.parse(
      @fs.read_file("target/verified-candidates/" + dir + "/manifest.json").text(),
    )
    guard manifest is { "full_release_ready": True, .. } else {
      fail(
        "candidate explicitly excludes required capabilities; full release prohibited",
      )
    }
  }
  println(
    "Full release gate passed; the workflow may consume these exact artifacts.",
  )
}
