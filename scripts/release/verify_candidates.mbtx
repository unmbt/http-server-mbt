///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let expected = @env.get_env_var("RELEASE_COMMIT").unwrap_or(
    @shell.Cmd("git", ["rev-parse", "HEAD"]).output().stdout().trim().to_owned(),
  )
  let seen : Set[String] = Set([])
  for dir in @fs.readdir("target/verified-candidates") {
    let root = "target/verified-candidates/" + dir
    let manifest = @json.parse(@fs.read_file(root + "/manifest.json").text())
    guard manifest
      is {
        "commit": String(sha),
        "dirty": False,
        "os": String(os),
        "cpu": String(cpu),
        "artifacts": Array(artifacts),
        ..
      } else {
      fail("invalid or dirty candidate: " + dir)
    }
    assert_eq(sha, expected)
    let platform = os + "/" + cpu.to_lower()
    if seen.contains(platform) {
      fail("duplicate platform candidate")
    }
    seen.add(platform)
    if artifacts.is_empty() {
      fail("empty artifact inventory")
    }
    for artifact in artifacts {
      guard artifact
        is {
          "path": String(path),
          "sha256": String(hash),
          "bytes": Number(size, ..),
          ..
        } else {
        fail("invalid artifact record")
      }
      if path.has_prefix("/") ||
        path.contains("\\") ||
        path.contains(":") ||
        path.split("/").any(p => p == "..") {
        fail("unsafe artifact path")
      }
      assert_eq(
        @fs.read_file(root + "/" + path).binary().length().to_double(),
        size,
      )
      let result = @shell.Cmd("sha256sum", [root + "/" + path]).output()
      result.check()
      assert_eq(result.stdout().split(" ").next().unwrap(), hash)
    }
  }
  for platform in ["Windows/amd64", "Linux/x86_64", "Darwin/arm64"] {
    if !seen.contains(platform) {
      fail("missing platform: " + platform)
    }
  }
  println(
    "All three same-commit candidate inventories verified. This is not full-release approval.",
  )
}
