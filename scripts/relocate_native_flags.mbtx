import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  for path in ["core/moon.pkg","full/moon.pkg","c_abi/full/moon.pkg","c_abi/thin/moon.pkg","server/moon.pkg","server/plain/moon.pkg"] {
    let source=@fs.read_file(path).text().replace_all(old="-fPIC",new="${HS_C_FLAGS}")
    @fs.write_file(path,source)
  }
  let path="tls/moon.pkg"
  let lines=@fs.read_file(path).text().split("\n").map(line => {
    if line.contains("\"stub-cc-flags\"") { "      \"stub-cc-flags\": \"${HS_TLS_FLAGS}\"," }
    else { line.to_owned().replace_all(old="-fPIC",new="${HS_C_FLAGS}") }
  }).to_array()
  @fs.write_file(path,lines.join("\n"))
  for path in ["cmd/http-server-mbt/moon.pkg","cmd/http-server-mbt-thin/moon.pkg"] {
    @fs.write_file(path,@fs.read_file(path).text()+"\noptions(link: { \"native\": { \"cc-flags\": \"${HS_C_FLAGS}\", \"cc-link-flags\": \"${HS_CLI_LINK}\" } })\n")
  }
  for path in ["moon.pkg","internal/native/moon.pkg","cmd/common/moon.pkg"] {
    @fs.write_file(path,@fs.read_file(path).text()+"\noptions(link: { \"native\": { \"cc-flags\": \"${HS_C_FLAGS}\", \"stub-cc-flags\": \"${HS_C_FLAGS}\" } })\n")
  }
}
