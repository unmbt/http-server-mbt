import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs" }
async fn main {
  for path in ["server/moon.pkg","server/plain/moon.pkg"] {
    let s=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
    @fs.write_file(path,s.replace(old="import {",new="import {\n  \"unmbt/http-server-mbt/internal/framing\","))
  }
  let path="server/plain/plain.mbt"
  let s=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
  let start=s.find("///|\npriv enum BodyState").unwrap()
  let end=s.find("///|\nfn status_reason").unwrap()
  let s=s[:start].to_owned()+s[end:].to_owned()
  let start=s.find("///|\n/// Drain a request body").unwrap()
  let s=s[:start].to_owned()+
    #|///|
    #|async fn handle_connection(server : Server, tcp : @socket.Tcp) -> Unit {
    #|  let reader = @framing.Connection::new(tcp)
    #|  while !server.stopped {
    #|    let head = if server.config.idle_timeout_ms > 0 {
    #|      @async.with_timeout_opt(server.config.idle_timeout_ms, () => reader.read_request())
    #|    } else { Some(reader.read_request()) }
    #|    guard head is Some(head) else { break }
    #|    let req=head.request
    #|    server.active_requests.val += 1
    #|    let keep = {
    #|      defer server.active_requests.val -= 1
    #|      let keep=match server.engine.handle(req) {
    #|        @root.HandleResult::Handled(response) => send_response(tcp,response,head.http11)
    #|        @root.HandleResult::Next => send_error(tcp,404,"Not Found")
    #|        @root.HandleResult::Error(@root.ServerError::Forbidden(_)) => send_error(tcp,403,"Forbidden")
    #|        @root.HandleResult::Error(@root.ServerError::Overloaded) => send_error(tcp,503,"Service Unavailable")
    #|        @root.HandleResult::Error(_) => send_error(tcp,500,"Internal Server Error")
    #|      }
    #|      if keep && head.keep_alive { reader.drain() }
    #|      keep
    #|    }
    #|    if !keep || !head.keep_alive { break }
    #|  }
    #|}
    #|///|
    #|async fn send_error(tcp : @socket.Tcp,status : Int,reason : String) -> Bool {
    #|  tcp.write("HTTP/1.1 \{status} \{reason}\r\nConnection: close\r\nContent-Length: \{reason.length()}\r\n\r\n\{reason}")
    #|  false
    #|}
  @fs.write_file(path,s.replace(old="response : @root.Response) -> Bool",new="response : @root.Response, http11 : Bool) -> Bool")
    .replace(old="let chunked=response.content_length() is None",new="let streaming=response.content_length() is None\n  let chunked=streaming && http11\n  response.check()\n  if streaming && !http11 { response.headers[\"Connection\"]=\"close\" }")
    .replace(old="if chunked { response.write_to(tcp, chunked=true) } else { response.send_to(tcp) }\n    true",new="if chunked { response.write_to(tcp, chunked=true) } else { response.send_to(tcp) }\n    !(streaming && !http11)"))

  let path="server/server.mbt"
  let s=@fs.read_file(path).text().replace_all(old="\r\n",new="\n")
  let start=s.find("///|\n/// Map a parsed HTTP request").unwrap()
  let end=s.find("///|\n/// Decide whether the connection").unwrap()
  let s=s[:start].to_owned()+s[end:].to_owned()
  let start=s.find("///|\n/// Plain-path request handling").unwrap()
  let end=s.find("///|\nasync fn handle_connection").unwrap()
  let s=s[:start].to_owned()+s[end:].to_owned()
  let start=s.find("///|\n/// Uniformly handle").unwrap()
  let end=s.find("///|\nfn status_reason").unwrap()
  let replacement=
    #|///|
    #|async fn handle_client(server : Server, transport : Transport) -> Unit {
    #|  let reader=@framing.Connection::new(transport.reader)
    #|  while !server.stopped {
    #|    let head=if server.config.idle_timeout_ms>0 {
    #|      @async.with_timeout_opt(server.config.idle_timeout_ms, () => reader.read_request())
    #|    } else { Some(reader.read_request()) }
    #|    guard head is Some(head) else { break }
    #|    let req=head.request
    #|    server.active_requests.val += 1
    #|    let keep={
    #|      defer server.active_requests.val -= 1
    #|      if server.has_upgrade_capability() && @framing.has_token(req.headers.get("upgrade").unwrap_or(""),"websocket") {
    #|        proxy_websocket(server,transport,reader,req)
    #|        false
    #|      } else {
    #|        let keep=dispatch_engine_request(server,transport,req.meth,req.headers,req.target,head.http11)
    #|        if keep && head.keep_alive { reader.drain() }
    #|        keep
    #|      }
    #|    }
    #|    if !keep || !head.keep_alive { break }
    #|  }
    #|}
    #|
  let s=s[:start].to_owned()+replacement+s[end:].to_owned()
  let start=s.find("///|\nasync fn send_bytes_bounded").unwrap()
  let end=s.find("///|\nasync fn send_fallback_status").unwrap()
  let s=s[:start].to_owned()+s[end:].to_owned()
  @fs.write_file(path,s
    .replace(old="  target : String,\n) -> Bool {",new="  target : String,\n  http11 : Bool,\n) -> Bool {")
    .replace(old="send_response(transport, response)",new="send_response(transport, response, http11)")
    .replace(old="  response : @root.Response,\n) -> Bool {",new="  response : @root.Response,\n  http11 : Bool,\n) -> Bool {\n  defer response.close()\n  response.check()")
    .replace(old="let chunked=response.content_length() is None",new="let streaming=response.content_length() is None\n  let chunked=streaming && http11\n  if streaming && !http11 { response.headers[\"Connection\"]=\"close\" }")
    .replace(old="  defer response.close()\n  try {",new="  try {")
    .replace(old="    true\n  } catch { _ => false }",new="    !(streaming && !http11)\n  } catch { _ => false }"))
}
