// Reproducible vendoring of Mbed TLS for the `tls` package (D-08, T-002/T-012).
//
// Downloads (or reuses) the pinned release tarball, verifies its SHA-256,
// extracts the TLS/crypto sources into tls/mbedtls-4.2.0/, applies the
// managed config overrides and regenerates tls/moon.pkg. Run from the module
// root:
//
//   moon run scripts/vendor_tls.mbtx [path/to/mbedtls-<ver>.tar.bz2]
//
// Without an argument the tarball is downloaded from the pinned URL into a
// temporary directory. The committed tls/mbedtls-4.2.0 tree is the product of
// this script; do not edit vendored files by hand.
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/shell" @shell,
  "moonbitlang/core/env" @env,
}

///|
const MBEDTLS_VERSION : String = "4.2.0"

///|
const TARBALL_SHA256 : String =
  "2bed9d713b4668f76553b097e72b8aa30bc8f112a940d7ae228d524bbde6ffea"

///|
const TARBALL_URL : String =
  "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-\{MBEDTLS_VERSION}/mbedtls-\{MBEDTLS_VERSION}.tar.bz2"

///|
const EXTRACT_ROOT : String = "mbedtls-\{MBEDTLS_VERSION}"

///|
/// Managed override block appended to include/mbedtls/mbedtls_config.h.
/// Rationale (design D-08):
/// - MBEDTLS_NET_C: socket syscalls stay in MoonBit (moonbitlang/async event
///   loop); TLS uses a custom BIO, no ws2_32/POSIX socket dependency.
/// - MBEDTLS_TIMING_C: no DTLS/timing anti-DoS; the event loop owns time.
/// - MBEDTLS_FS_IO: file IO stays in MoonBit (async/fs); cert/key parsing is
///   buffer-based only (also avoids Windows wide-char path issues in C).
/// - PSA ITS file / key storage: no persistent key storage on desktop.
/// - Custom allocator / NV seed: unused.
/// MBEDTLS_HAVE_TIME_DATE is intentionally kept so certificate expiry checks
/// work (N-12 depends on them).
const MBEDTLS_CONFIG_OVERRIDES : String =
  (
    #|/* ==== http-server-mbt managed overrides (begin) ====
    #|   Regenerated by scripts/vendor_tls.mbtx. Do not edit by hand.
    #|   See the script header for the rationale of each #undef. */
    #|#undef MBEDTLS_NET_C
    #|#undef MBEDTLS_TIMING_C
    #|#undef MBEDTLS_FS_IO
    #|#undef MBEDTLS_PSA_ITS_FILE_C
    #|#undef MBEDTLS_PSA_CRYPTO_STORAGE_C
    #|#undef MBEDTLS_MEMORY_BUFFER_ALLOC_C
    #|#undef MBEDTLS_ENTROPY_NV_SEED
    #|#undef MBEDTLS_PLATFORM_NV_SEED_ALT
    #|/* ==== http-server-mbt managed overrides (end) ==== */
  )

const OVERRIDES_BEGIN : String = "http-server-mbt managed overrides (begin)"

const OVERRIDES_END : String = "http-server-mbt managed overrides (end)"

///|
const INCLUDE_FLAGS : String =
  "-I tls/mbedtls-4.2.0/include -I tls/mbedtls-4.2.0/tf-psa-crypto/include -I tls/mbedtls-4.2.0/library -I tls/mbedtls-4.2.0/tf-psa-crypto/core -I tls/mbedtls-4.2.0/tf-psa-crypto/dispatch -I tls/mbedtls-4.2.0/tf-psa-crypto/platform -I tls/mbedtls-4.2.0/tf-psa-crypto/utilities -I tls/mbedtls-4.2.0/tf-psa-crypto/extras -I tls/mbedtls-4.2.0/tf-psa-crypto/drivers/builtin/include -I tls/mbedtls-4.2.0/tf-psa-crypto/drivers/builtin/src"

///|
/// Subtrees copied from the tarball: (source relative to tarball root,
/// destination relative to tls/mbedtls-4.2.0). Only *.c and *.h files are
/// copied; LICENSE files are copied verbatim.
let copy_trees : Array[(String, String)] = [
  ("include", "include"),
  ("library", "library"),
  ("tf-psa-crypto/include", "tf-psa-crypto/include"),
  ("tf-psa-crypto/core", "tf-psa-crypto/core"),
  ("tf-psa-crypto/platform", "tf-psa-crypto/platform"),
  ("tf-psa-crypto/utilities", "tf-psa-crypto/utilities"),
  ("tf-psa-crypto/extras", "tf-psa-crypto/extras"),
  ("tf-psa-crypto/dispatch", "tf-psa-crypto/dispatch"),
  (
    "tf-psa-crypto/drivers/builtin/src",
    "tf-psa-crypto/drivers/builtin/src",
  ),
  (
    "tf-psa-crypto/drivers/builtin/include",
    "tf-psa-crypto/drivers/builtin/include",
  ),
]

///|
let license_files : Array[(String, String)] = [
  ("LICENSE", "LICENSE"),
  ("tf-psa-crypto/LICENSE", "tf-psa-crypto/LICENSE"),
]

///|
/// Sources excluded from the compile list: MBEDTLS_NET_C is disabled, so
/// net_sockets.c would compile to nothing anyway; excluding it keeps the
/// module free of any socket API reference.
let excluded_sources : Array[String] = ["library/net_sockets.c"]

///|
/// Config headers that must be pure ASCII (MSVC C4819 under east-Asian
/// codepages otherwise fires on every translation unit including them).
let ascii_only_headers : Array[String] = [
  "include/mbedtls/mbedtls_config.h",
  "tf-psa-crypto/include/psa/crypto_config.h",
]

///|
/// Pure lexicographic comparison by UTF-16 code units. String::compare in the
/// current core orders by length first, which is not the lexical order we want
/// for a reproducible file manifest.
fn lex_cmp(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let ca = a[i]
    let cb = b[i]
    if ca < cb {
      return -1
    }
    if ca > cb {
      return 1
    }
  }
  if a.length() < b.length() {
    return -1
  }
  if a.length() > b.length() {
    return 1
  }
  0
}

///|
async fn main {
  let args = @env.args()
  let tarball = match args.get(1) {
    Some(path) => path
    None => {
      let tmp = @fs.tmpdir(prefix="mbedtls-vendor-")
      let path = tmp + "/mbedtls-\{MBEDTLS_VERSION}.tar.bz2"
      println("vendor_tls: downloading \{TARBALL_URL}")
      @shell.Cmd(
          "curl",
          ["-L", "--fail", "--retry", "3", "-o", path, TARBALL_URL],
        )
        .output()
        .check()
      path
    }
  }
  guard @fs.exists(tarball) else {
    abort("vendor_tls: tarball not found: \{tarball}")
  }
  verify_sha256(tarball)
  println("vendor_tls: sha256 verified (\{TARBALL_SHA256})")

  let work = @fs.tmpdir(prefix="mbedtls-extract-")
  @shell.Cmd("tar", ["-xjf", tarball, "-C", work]).output().check()
  let src_root = work + "/" + EXTRACT_ROOT
  guard @fs.exists(src_root + "/library") else {
    abort("vendor_tls: unexpected tarball layout under \{src_root}")
  }

  let dst_root = "tls/" + EXTRACT_ROOT
  if @fs.exists(dst_root) {
    @fs.rmdir(dst_root, recursive=true)
  }
  @fs.mkdir(dst_root, recursive=true)
  let mut copied = 0
  for tree in copy_trees {
    let (src, dst) = tree
    copied += copy_tree(src_root + "/" + src, dst_root + "/" + dst)
  }
  for entry in license_files {
    let (src, dst) = entry
    @fs.write_file(
      dst_root + "/" + dst,
      @fs.read_file(src_root + "/" + src).binary(),
    )
    copied += 1
  }
  println("vendor_tls: copied \{copied} files into \{dst_root}")

  for header in ascii_only_headers {
    transform_config(dst_root + "/" + header)
  }
  regenerate_moon_pkg()
  println("vendor_tls: config overrides applied, tls/moon.pkg regenerated")
  println("vendor_tls: done (mbedtls \{MBEDTLS_VERSION})")
}

///|
fn is_windows() -> Bool {
  @env.get_env_var("OS") == Some("Windows_NT")
}

///|
async fn verify_sha256(path : String) -> Unit {
  let actual = if is_windows() {
    // certutil reports the digest as a standalone line of its output.
    let out = {
      let res = @shell.Cmd("certutil", ["-hashfile", path, "SHA256"]).output()
      res.check()
      res.stdout()
    }
    match extract_hex64(out) {
      Some(hex) => hex
      None => abort("vendor_tls: cannot parse certutil hash output")
    }
  } else {
    let sha256sum = @shell.Cmd("sha256sum", [path]).output()
    let out = if sha256sum.exit_code() == 0 {
      sha256sum.stdout()
    } else {
      let shasum = @shell.Cmd("shasum", ["-a", "256", path]).output()
      if shasum.exit_code() == 0 {
        shasum.stdout()
      } else {
        abort("vendor_tls: no sha256sum/shasum available on PATH")
      }
    }
    match extract_hex64(out) {
      Some(hex) => hex
      None => abort("vendor_tls: cannot parse hash output")
    }
  }
  guard actual == TARBALL_SHA256 else {
    abort(
      "vendor_tls: sha256 mismatch\n  expected: \{TARBALL_SHA256}\n  actual:   \{actual}",
    )
  }
}

///|
/// Extract the first 64-char hex token from tool output.
fn extract_hex64(text : String) -> String? {
  for line in text.split("\n") {
    let trimmed = line.trim().to_owned()
    if trimmed.length() == 64 && is_hex64(trimmed) {
      return Some(trimmed.to_lower())
    }
  }
  None
}

///|
fn is_hex64(text : String) -> Bool {
  for ch in text {
    let is_hex = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')
    if !is_hex {
      return false
    }
  }
  true
}

///|
/// Recursively copy *.c / *.h files, preserving relative paths. Returns the
/// number of files copied.
async fn copy_tree(src : String, dst : String) -> Int {
  let count : Ref[Int] = Ref(0)
  copy_tree_inner(src, src, dst, count)
  count.val
}

///|
async fn copy_tree_inner(
  root : String,
  current : String,
  dst_root : String,
  count : Ref[Int],
) -> Unit {
  let entries = @fs.readdir(current, sort=true) catch {
    _ => {
      println("vendor_tls: warn: cannot read \{current}")
      return
    }
  }
  for name in entries {
    let path = current + "/" + name
    match @fs.kind(path) {
      Directory => copy_tree_inner(root, path, dst_root, count)
      Regular =>
        if name.has_suffix(".c") || name.has_suffix(".h") {
          let rel = path[root.length():].to_owned()
          let target = dst_root + rel
          mkdir_parent(target)
          @fs.write_file(target, @fs.read_file(path).binary())
          count.val += 1
        }
      _ => ()
    }
  }
}

///|
/// Create every ancestor directory of the file path `path`.
async fn mkdir_parent(path : String) -> Unit {
  let normalized = path.replace(old="\\", new="/")
  let parts = normalized.split("/").to_array()
  let mut acc = ""
  for i in 0..<(parts.length() - 1) {
    let part = parts[i].to_owned()
    acc = if acc is "" {
      part
    } else {
      acc + "/" + part
    }
    // A Windows drive prefix like "E:" is not a directory.
    if i == 0 && acc.length() == 2 && acc[1] == ':' {
      continue
    }
    if part is "" || acc is "" {
      continue
    }
    if !@fs.exists(acc) {
      @fs.mkdir(acc, recursive=true)
    }
  }
}

///|
/// Replace (or append) the managed override block and strip non-ASCII
/// characters (they only ever appear in comments; MSVC C4819 otherwise).
async fn transform_config(path : String) -> Unit {
  let raw = @fs.read_file(path).text() catch {
    err => abort("vendor_tls: cannot read \{path}: \{err}")
  }
  let cleaned = StringBuilder(size_hint=raw.length())
  for ch in raw {
    if ch.to_int() < 0x80 {
      cleaned.write_char(ch)
    } else {
      cleaned.write_char(' ')
    }
  }
  let content = cleaned.to_string()
  let base = match content.find(OVERRIDES_BEGIN) {
    Some(start) => {
      let end_rel = match content.find(OVERRIDES_END) {
        Some(v) => v
        None => abort("vendor_tls: unbalanced managed block in \{path}")
      }
      let end = end_rel + OVERRIDES_END.length()
      content[:start].to_owned() + content[find_line_end_after(content, end):].to_owned()
    }
    None => content
  }
  let trimmed = base.trim().to_owned()
  let updated = trimmed + "\n\n" + MBEDTLS_CONFIG_OVERRIDES
  @fs.write_file(path, updated)
}

///|
fn find_line_end_after(content : String, index : Int) -> Int {
  let newline : UInt16 = '\n'
  let mut i = index
  while i < content.length() {
    if content[i] == newline {
      return i + 1
    }
    i += 1
  }
  content.length()
}

///|
/// Regenerate tls/moon.pkg: the native-stub list is the sorted set of vendored
/// *.c files plus tls_bridge.c; stub-cc-flags carries the include paths (the
/// compiler runs with the module root as its working directory).
async fn regenerate_moon_pkg() -> Unit {
  // native-stub paths resolve relative to the package directory (tls/),
  // while stub-cc-flags resolve against the module root (compiler cwd).
  let sources : Array[String] = []
  @fs.walk(
    "tls/mbedtls-4.2.0",
    async fn(dir, files) {
      for name in files {
        if name.has_suffix(".c") {
          let full = dir + "/" + name
          sources.push(full["tls/".length():].to_owned())
        }
      }
      let _ = @fs.exists(dir)
    },
  )
  sources.retain(fn(name) {
    for excluded in excluded_sources {
      if name.has_suffix("/" + excluded) {
        return false
      }
    }
    true
  })
  // Manual lexicographic insertion sort. Do NOT use Array::sort here: this
  // core version's String::compare orders by length first, then content,
  // which scrambles the file list relative to the expected lexical order.
  for i in 1..<sources.length() {
    let key = sources[i]
    let mut j = i - 1
    while j >= 0 && lex_cmp(sources[j], key) > 0 {
      sources[j + 1] = sources[j]
      j -= 1
    }
    sources[j + 1] = key
  }
  let buf = StringBuilder(size_hint=8192)
  buf.write_string("import {\n")
  buf.write_string("  \"moonbitlang/async/io\",\n")
  buf.write_string("  \"moonbitlang/core/cmp\",\n")
  buf.write_string("  \"moonbitlang/core/encoding/utf8\",\n")
  buf.write_string("}\n")
  buf.write_string(
    "import {\n  \"moonbitlang/async\",\n  \"moonbitlang/async/fs\",\n  \"moonbitlang/async/io\",\n  \"moonbitlang/async/socket\",\n  \"moonbitlang/core/encoding/utf8\",\n} for \"test\"\n")
  buf.write_string(
    "// TLS package backed by vendored Mbed TLS \{MBEDTLS_VERSION} + TF-PSA-Crypto 1.2.0.\n",
  )
  buf.write_string(
    "// Generated by scripts/vendor_tls.mbtx - do not edit by hand.\n",
  )
  buf.write_string("options(\n  \"native-stub\": [\n")
  for src in sources {
    buf.write_string("    \"\{src}\",\n")
  }
  buf.write_string("    \"tls_bridge.c\",\n")
  buf.write_string("  ],\n")
  buf.write_string(
    "  \"link\": { \"native\": { \"cc-flags\": \"-fPIC\", \"stub-cc-flags\": \"-fPIC \{INCLUDE_FLAGS}\" } },\n",
  )
  buf.write_string("  targets: { \"*.mbt\": [ \"native\" ] },\n")
  buf.write_string(")\n")
  @fs.write_file("tls/moon.pkg", buf.to_string())
  println("vendor_tls: tls/moon.pkg lists \{sources.length() + 1} stub files")
}
