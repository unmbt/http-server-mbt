// D-05/D-08 / T-023: pinned MIT liburing subset, no configure at consumer build.
import { "moonbitlang/async@0.21.3", "moonbitlang/async@0.21.3/fs", "moonbitlang/async@0.21.3/shell", "moonbitlang/core/env" }
async fn main {
  let cache="target/vendor-uring"
  if !@fs.exists(cache) { @fs.mkdir(cache,recursive=true) }
  let args=@env.args()
  let archive=if args.length()==2 { args[1] } else { cache+"/liburing-2.9.tar.gz" }
  if !@fs.exists(archive) {
    @shell.Cmd("curl",["--fail","--location","https://github.com/axboe/liburing/archive/refs/tags/liburing-2.9.tar.gz","--output",archive]).run()
  }
  let hash=@shell.Cmd("sha256sum",[archive]).output();hash.check()
  assert_true(hash.stdout().has_prefix("897b1153b55543e8b92a5a3eb9b906537a5fedcf8afaf241f8b8787940c79f8d "))
  @shell.Cmd("tar",["-xf",archive,"-C",cache]).run()
  let source=cache+"/liburing-liburing-2.9"
  let destination="internal/native/liburing-2.9"
  if !@fs.exists(destination) { @fs.mkdir(destination,recursive=true) }
  let units=["setup","queue","register","syscall","version"]
  @fs.walk(source+"/src",async fn(dir,files) {
    for name in files {
      if !name.has_suffix(".h") && !units.any(unit=>name==unit+".c") { continue }
      let relative=(dir+"/"+name)[(source+"/").length():].to_owned()
      let target=destination+"/"+relative
      let parent=target.split("/").to_array()
      let parent=parent[:parent.length()-1].join("/")
      if !@fs.exists(parent) { @fs.mkdir(parent,recursive=true) }
      @fs.write_file(target,@fs.read_file(dir+"/"+name))
    }
  },max_concurrency=1)
  @fs.write_file(destination+"/LICENSE",@fs.read_file(source+"/LICENSE"))
  // Linux >= 5.6 build headers, libc mode, portable across glibc/musl.
  // These are the upstream configure branches for time_types/openat2, with
  // the documented fallback for the optional newer discard command.
  @fs.write_file(destination+"/src/include/liburing/compat.h",
    "/* SPDX-License-Identifier: MIT; generated by scripts/vendor_uring.mbtx */\n#ifndef LIBURING_COMPAT_H\n#define LIBURING_COMPAT_H\n#include <linux/time_types.h>\n#define UAPI_LINUX_IO_URING_H_SKIP_LINUX_TIME_TYPES_H 1\n#include <linux/openat2.h>\n#include <linux/ioctl.h>\n#ifndef BLOCK_URING_CMD_DISCARD\n#define BLOCK_URING_CMD_DISCARD _IO(0x12, 0)\n#endif\n#endif\n")
  @fs.write_file(destination+"/src/include/liburing/io_uring_version.h",
    "/* SPDX-License-Identifier: MIT */\n#ifndef LIBURING_VERSION_H\n#define LIBURING_VERSION_H\n#define IO_URING_VERSION_MAJOR 2\n#define IO_URING_VERSION_MINOR 9\n#endif\n")
  for unit in units {
    @fs.write_file("internal/native/uring_"+unit+".c",
      "/* Generated by scripts/vendor_uring.mbtx. Upstream source is unmodified. */\n#if defined(__linux__) && !defined(HS_DISABLE_IO_URING)\n#define _GNU_SOURCE\n#define LIBURING_INTERNAL\n#include \"liburing-2.9/src/"+unit+".c\"\n#endif\n")
  }
  println("vendored liburing 2.9 MIT subset; SHA-256 verified")
}
