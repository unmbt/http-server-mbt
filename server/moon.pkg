import {
  "unmbt/http-server-mbt/internal/native",
  "unmbt/http-server-mbt/internal/framing",
  "unmbt/http-server-mbt" @root,
  "unmbt/http-server-mbt/core",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "moonbitlang/async/types",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/async/fs",
}

import {
  "moonbitlang/async/websocket",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/core/string",
} for "test"

options(
  link: { "native": { "cc-flags": "${build.HS_C_FLAGS}", "stub-cc-flags": "${build.HS_C_FLAGS}" } },
  targets: { "*.mbt": [ "native" ] },
)
