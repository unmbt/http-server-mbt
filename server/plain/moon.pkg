import {
  "unmbt/http-server-mbt/internal/native",
  "unmbt/http-server-mbt/internal/framing",
  "unmbt/http-server-mbt" @root,
  "unmbt/http-server-mbt/core",
  "moonbitlang/async",
  "moonbitlang/async/socket",
}

options(
  link: { "native": { "cc-flags": "${build.HS_C_FLAGS}", "stub-cc-flags": "${build.HS_C_FLAGS}" } },
  targets: { "*.mbt": [ "native" ] },
)
